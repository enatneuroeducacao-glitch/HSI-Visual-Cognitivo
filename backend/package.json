    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "8.7.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "10.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "prisma": "6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "supertest": "7.1.4",
    "@types/supertest": "6.0.3"
  },
  "overrides": {
