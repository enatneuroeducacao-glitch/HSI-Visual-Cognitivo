generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALYST
  PARTICIPANT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum InstitutionType {
  SCHOOL
  COMPANY
  PUBLIC_AGENCY
  RESEARCH_CENTER
  OTHER
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  passwordHash       String
  role               UserRole     @default(PARTICIPANT)
  status             UserStatus   @default(INVITED)
  participantCode    String?      @unique
  publicAccess       Boolean      @default(false)
  birthDate          DateTime?    @db.Date
  sex                String?      @db.VarChar(1)
  city               String?
  state              String?      @db.VarChar(2)
  licenseCategory    String?
  institutionType    String?
  institutionName    String?
  groupSector        String?
  privacyNoticeVersion String?
  privacyAcknowledgedAt DateTime?
  researchConsentVersion String?
  researchConsentedAt DateTime?
  researchConsentGranted Boolean @default(false)
  consentEvents ConsentEvent[]
  privacyRequests PrivacyRequest[]
  groupId            String?
  group              ParticipantGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  results            AssessmentResult[]
  instrumentResults  InstrumentAssessment[]
  participantDrafts  ParticipantDraft[]
  resetTokens        PasswordResetToken[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  @@index([publicAccess, createdAt])
  @@index([state, city])
}

model ParticipantGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  users       User[]
  institutionId String?
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  city        String?
  state       String? @db.VarChar(2)
  assessments InstrumentAssessment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AssessmentResult {
  id               String   @id
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  participantCode  String
  mode             String
  completedAt      DateTime
  totalQuestions   Int
  correct          Int
  accuracy         Int
  durationSeconds  Int
  axes             Json
  answerDetails    Json
  createdAt        DateTime @default(now())
  applicationNumber Int @default(1)
  applicationType   String @default("BASELINE")
  studyCode         String?
  instrumentVersion String @default("1.0")
  instrumentVersionId String?
  instrumentVersionRecord InstrumentVersion? @relation(fields: [instrumentVersionId], references: [id], onDelete: SetNull)
  scoringSnapshot Json @default("{}")
  researchConsentGranted Boolean @default(false)
  researchConsentVersion String?
  researchConsentedAt DateTime?
  versionVerification String @default("UNVERIFIED_LEGACY")
  studyId String?
  study ScientificStudy? @relation(fields: [studyId], references: [id], onDelete: SetNull)
  studyGroupId String?
  studyGroup StudyGroup? @relation(fields: [studyGroupId], references: [id], onDelete: SetNull)

  @@unique([userId, applicationNumber])
  @@index([applicationType, completedAt])
  @@index([userId, completedAt])
  @@index([completedAt])
  @@index([participantCode])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}
model InstrumentAssessment {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument  String
  context     String
  completedAt DateTime
  answers     Json
  dimensions  Json
  createdAt   DateTime @default(now())

  groupId       String?
  group         ParticipantGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  city          String?
  state         String? @db.VarChar(2)
  contextVersion String @default("1.0")
  consentVersion String?
  consentedAt    DateTime?
  researchConsentGranted Boolean @default(false)
  birthDate      DateTime? @db.Date
  sex            String?  @db.VarChar(1)
  licenseCategory String?
  institutionType String?
  institutionName String?
  groupSector     String?
  applicationNumber Int @default(1)
  applicationType   String @default("BASELINE")
  studyCode         String?
  instrumentVersion String @default("1.0")
  instrumentVersionId String?
  instrumentVersionRecord InstrumentVersion? @relation(fields: [instrumentVersionId], references: [id], onDelete: SetNull)
  scoringSnapshot Json @default("{}")
  versionVerification String @default("UNVERIFIED_LEGACY")
  studyId String?
  study ScientificStudy? @relation(fields: [studyId], references: [id], onDelete: SetNull)
  studyGroupId String?
  studyGroup StudyGroup? @relation(fields: [studyGroupId], references: [id], onDelete: SetNull)

  @@unique([userId, instrument, applicationNumber])
  @@index([applicationType, completedAt])
  @@index([userId, completedAt])
  @@index([instrument, completedAt])
  @@index([context, completedAt])
  @@index([institutionId, completedAt])
  @@index([groupId, completedAt])
}

model Institution {
  id          String          @id @default(cuid())
  name        String
  type        InstitutionType @default(OTHER)
  city        String
  state       String          @db.VarChar(2)
  country     String          @default("BR") @db.VarChar(2)
  active      Boolean         @default(true)
  groups      ParticipantGroup[]
  assessments InstrumentAssessment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([state, city])
  @@index([type, active])
}


enum ScientificStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model InstrumentVersion {
  id             String   @id @default(cuid())
  instrument     String
  version        String
  status         String   @default("DRAFT")
  changeSummary  String
  questions      Json
  scoringCriteria Json
  createdBy      String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cognitiveResults AssessmentResult[]
  behavioralResults InstrumentAssessment[]
  @@unique([instrument, version])
  @@index([instrument, status])
}

model StudyProtocol {
  id                     String   @id @default(cuid())
  title                  String
  version                String   @default("1.0")
  researchQuestion       String
  hypothesis             String
  targetPopulation       String
  inclusionCriteria      String
  exclusionCriteria      String
  samplingStrategy       String
  sampleSizeRationale    String
  analysisPlan           String
  ethicalConsiderations  String?
  createdBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  studies                ScientificStudy[]
  @@index([title])
}

model ScientificStudy {
  id                String   @id @default(cuid())
  code              String   @unique
  title             String
  description       String?
  hypothesis        String
  targetPopulation  String
  inclusionCriteria String
  exclusionCriteria String?
  samplingPlan      String
  analysisPlan      String
  status            ScientificStatus @default(DRAFT)
  protocolId        String?
  protocol          StudyProtocol? @relation(fields: [protocolId], references: [id], onDelete: SetNull)
  groups            StudyGroup[]
  cognitiveResults  AssessmentResult[]
  behavioralResults InstrumentAssessment[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([status, createdAt])
}

model StudyGroup {
  id          String   @id @default(cuid())
  studyId     String
  study       ScientificStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  code        String
  name        String
  arm         String
  description String?
  createdAt   DateTime @default(now())
  cognitiveResults AssessmentResult[]
  behavioralResults InstrumentAssessment[]
  @@unique([studyId, code])
  @@index([studyId, arm])
}


model ConsentEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  purpose String
  granted Boolean
  consentVersion String
  privacyNoticeVersion String?
  instrument String?
  assessmentId String?
  source String
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
  @@index([purpose,granted,createdAt])
}

model PrivacyRequest {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  requestType String
  description String?
  status String @default("RECEIVED")
  resolutionNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,createdAt])
  @@index([userId,createdAt])
}

model RetentionPolicy {
  id String @id @default(cuid())
  recordType String @unique
  retentionMonths Int
  rationale String
  active Boolean @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
}


model ParticipantDraft {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument String
  payload   Json
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  @@unique([userId, instrument])
  @@index([expiresAt])
}

model ScientificValidationEvidence {
  id                 String   @id @default(cuid())
  instrument         String
  evidenceType       String
  title              String
  versionScope       String
  studyCode          String?
  protocolReference  String?
  methodDescription  String
  population         String
  sampleSize         Int       @default(0)
  sampleDescription  String
  findings           String
  interpretation     String
  limitations        String
  ethicalStatus      String   @default("NOT_ASSESSED")
  ethicsReference    String?
  status             String   @default("PLANNED")
  reviewer           String?
  reviewedAt         DateTime?
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([instrument, evidenceType, status])
  @@index([studyCode])
  @@index([createdAt])
}
